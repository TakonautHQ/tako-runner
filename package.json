{
  "name": "@takonaut/tako-runner",
  "version": "0.2.1",
  "description": "Customer-managed Takonaut Project Agent Runner powered by Pi",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/TakonautHQ/tako-runner.git"
  },
  "homepage": "https://github.com/TakonautHQ/tako-runner#readme",
  "bugs": {
    "url": "https://github.com/TakonautHQ/tako-runner/issues"
  },
  "keywords": [
    "takonaut",
    "runner",
    "project-agent",
    "pi"
  ],
  "bin": {
    "tako-runner": "./src/runner-cli.ts",
    "takonaut-runner": "./src/runner-cli.ts"
  },
  "files": [
    "src",
    "bun.lock",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:check": "bun pm pack --dry-run",
    "formula:render": "bun scripts/render-homebrew-formula.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
